# The assistant settings. Copy this file to .env (next to compose.yaml) and adjust it; docker compose
# reads .env when it starts the stack. Without a .env file, the assistant uses the defaults below with
# DOMO_SITE_ADDRESSES=localhost: the page then answers on https://localhost:8443 only.

# The HTTPS port of the web page on the server (https://<address>:8443).
DOMO_HTTPS_PORT=8443

# The HTTP port. It only redirects to the HTTPS one.
DOMO_HTTP_PORT=8080

# The names and addresses the page is opened with, separated by commas: the server's address on
# your network (and its name, if it has one). The certificate covers exactly these. If you open
# the page by IP address, make that address the FIRST IPv4 address of the list (names may come
# before it): a browser that opens the page by IP address sends no name, and only the first IPv4
# address of this list then gets its own certificate (the other addresses get a name-mismatch
# warning). IPv6 addresses are not supported here yet.
DOMO_SITE_ADDRESSES=localhost, 192.168.1.10

# The address of the server the two ports are published on: 0.0.0.0 for all of them, 127.0.0.1
# for this machine only.
DOMO_BIND_ADDRESS=0.0.0.0

# The time zone of the services, as a tz database name (for example Europe/Paris).
TZ=UTC

# Advanced: the first three numbers of the internal network of the services (a /24). Change it
# only if 10.247.81.0/24 is already used on your network.
# DOMO_CORE_NET_PREFIX=10.247.81
# The same for the network the page's ports are published on (10.247.80.0/24 by default).
# DOMO_LAN_NET_PREFIX=10.247.80
# The same for the network the speech service shares with the gatekeeper (10.247.83.0/24 by default).
# DOMO_SPEECH_NET_PREFIX=10.247.83
# And the speech service's way out, to fetch its models (10.247.89.0/24 by default).
# DOMO_SPEECH_EGRESS_NET_PREFIX=10.247.89

# A service on this same server is named host.docker.internal (for example
# http://host.docker.internal:8123): the compose file gives that name to the assistant's way out,
# on every Docker engine. On Docker Desktop, a service on 127.0.0.1 is reached. With a Docker
# Engine installed directly on Linux (WSL included), it is not: make the service listen on the
# Docker bridge address the name leads to (often 172.17.0.1; `docker compose exec gatekeeper
# getent ahostsv4 host.docker.internal` shows it), started after Docker, or on all addresses
# (0.0.0.0), which also shows it to the whole house network. A firewall on this server must let
# the Docker networks reach that port. That address is already counted as this server. With
# rootless Docker, the name does not lead to this server: name the service by an address of the
# server and put that address below. A daemon without a default bridge needs host-gateway-ip.

# Advanced: other IP addresses of this server, separated by commas (another network card, another
# Docker network), so that the assistant's programs count them as this machine, closed unless you open a
# port of it. Its IP addresses in DOMO_SITE_ADDRESSES are already counted.
# DOMO_EXTRA_HOST_ADDRESSES=192.168.1.11

# Advanced: where the speech service runs its models (`auto`, `cpu` or `gpu`). A graphics card
# also needs `docker compose -f compose.yaml -f compose.gpu.yaml up -d`.
# DOMO_SPEECH_DEVICE=auto
# Advanced: `no` hides the models whose licence restricts their use (one voice today: see the
# README of domo-speech). They are offered by default.
# DOMO_SPEECH_RESTRICTED_MODELS=yes
# Advanced: the most requests one model serves at once. The service measures how many this
# machine holds; this can only lower that number. Unset: what was measured.
# DOMO_SPEECH_AT_ONCE=2
# Advanced: a voice that runs as a separate program, as a path inside the speech container (put
# it in its models volume, for example under /models). Its candidates are tried only when set.
# DOMO_SPEECH_VOICE_PROGRAM=/models/voice/run
