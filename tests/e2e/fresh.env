# The stack of an end-to-end test that needs an instance nobody has set up yet (see
# tests/e2e/conftest.py), started and removed for that test alone while the shared stack
# (shared.env) and the stack of tests/stack/test.env may be up: its own ports and its own internal
# network, which Docker refuses to overlap. Published on this machine only.
DOMO_HTTPS_PORT=18454
DOMO_HTTP_PORT=18084
DOMO_SITE_ADDRESSES=localhost
DOMO_BIND_ADDRESS=127.0.0.1
TZ=UTC
DOMO_CORE_NET_PREFIX=10.247.93
# The upkeep resumes a chain paused until someone joins within this many seconds (a minute in a
# real instance): the scenarios do not wait a minute.
DOMO_UPKEEP_SECONDS=5
