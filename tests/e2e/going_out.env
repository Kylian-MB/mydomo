# The stack of the end-to-end story of going out (tests/e2e/test_going_out.py): the fake model and
# the fakes of going out (tests/stack/compose.going-out.yaml), next to the shared and fresh stacks
# of the end-to-end tests and to the stacks of tests/stack: its own ports and its own internal
# networks, which Docker refuses to overlap. Published on this machine only.
DOMO_HTTPS_PORT=18456
DOMO_HTTP_PORT=18086
DOMO_SITE_ADDRESSES=localhost
DOMO_BIND_ADDRESS=127.0.0.1
TZ=UTC
DOMO_CORE_NET_PREFIX=10.247.94
DOMO_LAN_NET_PREFIX=10.247.90
# The upkeep takes a build, a plan and a trigger due within this many seconds (a minute in a real
# instance): the scenarios do not wait a minute.
DOMO_UPKEEP_SECONDS=5
