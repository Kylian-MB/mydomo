# The stack of the voice trials (tests/e2e/test_voice_stack.py): the fake model service and the
# real speech service, its weights in a folder of this machine (compose.voice.yaml). Its own
# project, ports and internal networks, apart from the other stacks of the tests. Published on
# this machine only.
DOMO_HTTPS_PORT=18473
DOMO_HTTP_PORT=18093
DOMO_SITE_ADDRESSES=localhost
DOMO_BIND_ADDRESS=127.0.0.1
TZ=UTC
DOMO_CORE_NET_PREFIX=10.247.120
DOMO_LAN_NET_PREFIX=10.247.121
DOMO_SPEECH_NET_PREFIX=10.247.122
DOMO_SPEECH_EGRESS_NET_PREFIX=10.247.123
DOMO_UPKEEP_SECONDS=5
