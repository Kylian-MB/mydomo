# The voice trials with real models (tests/e2e/test_voice.py): defaults, the environment wins.
# The speech service runs as a plain local process (never in a container for these trials), on
# this machine only; the recorded set is built by scripts/voice_bench/make_voices.py OUTSIDE the
# repository, and what the trials measure is written beside it (no sound is ever committed).
DOMO_VOICE_TRIALS_URL=http://127.0.0.1:18500
DOMO_VOICE_TRIALS_DIR=D:/domo-voice-models/trials/voices
DOMO_VOICE_TRIALS_RESULTS=D:/domo-voice-models/trials/results
# A name for the run (the results file's): what the service runs on, for one (cpu, gpu).
DOMO_VOICE_TRIALS_LABEL=run
